{
  "name": "material-dna",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts benchmark --ignore-pattern benchmark/bench.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/build-bench.mjs && node benchmark/bench.mjs",
    "bench:embed": "node scripts/build-bench.mjs && node benchmark/bench.mjs --embed",
    "bench:check": "node scripts/check-bench.mjs",
    "bench:check:embed": "node scripts/check-bench.mjs --embed",
    "postinstall": "node scripts/prune-node-modules.mjs",
    "evaluate:policy": "node scripts/evaluate-review-policy.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.21",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
